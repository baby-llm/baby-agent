{
  "name": "offline-demo",
  "cases": [
    {
      "id": "direct-answer",
      "query": "Say hello",
      "expected_contains": ["hello"],
      "max_loop_depth": 1,
      "mock_responses": [
        {"content": "Hello from BabyAgent.", "usage": {"prompt_tokens": 20, "completion_tokens": 6}}
      ]
    },
    {
      "id": "tool-loop",
      "query": "Read the project README",
      "expected_contains": ["README"],
      "expected_tools": ["read"],
      "max_loop_depth": 2,
      "mock_responses": [
        {"tool_calls": [{"id": "call-read", "name": "read", "arguments": "README.md"}], "usage": {"prompt_tokens": 30, "completion_tokens": 10}},
        {"content": "The README describes BabyAgent.", "usage": {"prompt_tokens": 40, "completion_tokens": 8}}
      ]
    }
  ]
}
